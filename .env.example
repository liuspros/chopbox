# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_PAYSTACK_PUBLIC_KEY=

# Server-side only (never prefixed with VITE_, never sent to the browser).
# Used by /api routes. Set these as environment variables in your Vercel
# project dashboard for production — this .env file is only for local
# `vercel dev` testing.
PAYSTACK_SECRET_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=
